# Deployment: choose before running npm start or docker compose up --build -d.
APP_MODE=native
APP_PORT=3000
NODE_ENV=production
APP_NAME=Hotel Operations
APP_URL=http://localhost:3000

# native: embedded (default) or external postgres; docker: postgres only.
DB_TYPE=embedded
# PGlite stores a DIRECTORY here, even when the name ends in .db (not SQLite).
DB_FILE=./data/app.db
# Docker automatically uses db:5432; these address fields are for native PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hotel_operations
DB_USER=hotel_admin
# Required for postgres. Use a unique secret; no production default.
# Single quotes preserve literal $, #, @, :, / and spaces in dotenv/Compose.
DB_PASSWORD=
DB_SSL=false

# Required in production and for live OHIP. Generate locally:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Public production origins require HTTPS and secure cookies. Local HTTP is allowed.
COOKIE_SECURE=false
# OHIP OCIM: allow exact HTTPS gateway hostnames from Oracle's Environments page.
# Connections use only baseUrl, clientId, clientSecret, appKey, enterpriseId, hotelId.
# The backend owns scope urn:opc:hgbu:ws:__myscopes__; no chain/scope input is needed.
# Credentials are encrypted in the DB, not configured as shared tenant-wide env secrets.
# Keep ENCRYPTION_KEY stable to preserve saved credentials during migration/restarts.
# Exact comma-separated approved HTTPS OHIP gateway hostnames (no scheme/wildcards).
OHIP_ALLOWED_HOSTS=
POLL_INTERVAL_MS=60000
OHIP_REQUEST_INTERVAL_MS=250

# Optional synthetic demo bootstrap, development/test only; never prints passwords.
DEMO_SEED=false
DEMO_PASSWORD=
