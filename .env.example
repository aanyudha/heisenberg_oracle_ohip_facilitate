DATABASE_URL=postgres://hospitality:local-development-only@localhost:5432/hospitality
# For an embedded local PostgreSQL demo instead: omit DATABASE_URL and set LOCAL_DEMO=true
LOCAL_DEMO=false
LOCAL_DB_PATH=./data/demo
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Required for seed, minimum 12 characters. Never seed production.
DEMO_PASSWORD=
# 64 hex characters from a cryptographic random generator, required for real OHIP connections
ENCRYPTION_KEY=
# Comma-separated exact HTTPS gateway hostnames; no wildcards
OHIP_ALLOWED_HOSTS=
POLL_INTERVAL_MS=60000
OHIP_REQUEST_INTERVAL_MS=250
