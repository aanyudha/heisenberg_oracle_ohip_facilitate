# Defaults work without an .env file: native uses embedded DB; Compose uses internal PostgreSQL.
# NODE_ENV=production requires APP_MODE=server, PostgreSQL, HTTPS origin, secure cookies and encryption key.
NODE_ENV=development
APP_MODE=demo
DATABASE_URL=
# Optional; leave blank to choose automatically from DATABASE_URL.
LOCAL_DEMO=
LOCAL_DB_PATH=./data/demo
PORT=3000
HOST=127.0.0.1
# Blank resolves to http://localhost:$PORT. Set the exact HTTPS origin in production.
APP_ORIGIN=
COOKIE_SECURE=false
# Optional initial demo password (12+ characters); generated and printed on first startup if omitted.
# Demo mode initializes an empty database only. Server/production mode never seeds.
DEMO_PASSWORD=
# 64 hex characters from a cryptographic random generator, required for real OHIP connections
ENCRYPTION_KEY=
# Comma-separated exact HTTPS gateway hostnames; no wildcards
OHIP_ALLOWED_HOSTS=
POLL_INTERVAL_MS=60000
OHIP_REQUEST_INTERVAL_MS=250
